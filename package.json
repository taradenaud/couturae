{
  "name": "couturae",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "docker-compose up -d && npm run wait-for-services && npm run dev",
    "dev": "concurrently \"npm run api\" \"npm run normalizer\" \"npm run dashboard\"",
    "api": "cd services/api && npm run dev",
    "normalizer": "cd services/normalizer && npm run dev",
    "ingest": "cd services/ingestor && npx ts-node index.ts",
    "dashboard": "npx http-server -p 8080 -c-1 -o dashboard.html",
    "wait-for-services": "sleep 5",
    "stop": "docker-compose down",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taradenaud/couturae.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/taradenaud/couturae/issues"
  },
  "homepage": "https://github.com/taradenaud/couturae#readme",
  "devDependencies": {
    "@types/node": "^25.0.9",
    "concurrently": "^9.1.2",
    "http-server": "^14.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
